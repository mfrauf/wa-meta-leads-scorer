# WAHA environment (copy to waha/.env, chmod 600, never commit)
# Load with: set -a; source waha/.env; set +a (before running start-session.sh)
WAHA_API_KEY=change-me-generate-32-bytes-random
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-strong-password
# Shared with n8n HMAC verify node (must match waha/start-session.sh + n8n credential)
WAHA_HMAC_SECRET=change-me-generate-32-bytes-random-secret
